{
  "name": "clipforge-desktop",
  "version": "0.1.0",
  "description": "ClipForge - editor local para Reels, Shorts y TikTok",
  "main": "main.js",
  "author": "BenjayEstudios",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cl.clipforge.desktop",
    "productName": "ClipForge",
    "directories": { "output": "dist" },
    "files": [
      "**/*",
      "../index.php",
      "../api/**/*",
      "../assets/**/*",
      "../storage/.gitkeep"
    ],
    "extraResources": [
      { "from": "runtime", "to": "runtime" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "ClipForge-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipForge"
    }
  }
}
